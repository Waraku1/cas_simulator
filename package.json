{
  "name": "cas-flight-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "sync:cesium": "node scripts/sync-cesium.mjs",
    "predev": "pnpm sync:cesium",
    "dev": "vite dev --config vite.client.config.ts",
    "dev:cloudflare": "vite dev",
    "dev:school": "pnpm sync:cesium && node scripts/dev-school.mjs",
    "verify:school": "SCHOOL_URL=http://127.0.0.1:5173 node scripts/verify-production-multiplayer.mjs",
    "verify:school:c4b": "SCHOOL_URL=http://127.0.0.1:8787 node scripts/verify-school-matchmaking.mjs",
    "verify:school:c4c": "SCHOOL_URL=http://127.0.0.1:8787 node scripts/verify-school-competition.mjs",
    "verify:school:c4d": "SCHOOL_URL=http://127.0.0.1:5173 node scripts/verify-school-accounts.mjs",
    "verify:school:c4d:ranked": "SCHOOL_URL=http://127.0.0.1:5173 node scripts/verify-school-rated-product.mjs",
    "verify:c5d:school": "node scripts/verify-c5d-school-regression.mjs",
    "verify:production:c4d": "node scripts/verify-production-rated-product.mjs",
    "verify:c4c:runtime": "node scripts/verify-c4c-runtime.mjs",
    "verify:c4d:binding": "node scripts/verify-c4d-production-binding.mjs",
    "verify:c5a": "node scripts/verify-c5a-hardening.mjs",
    "verify:c5b": "node scripts/verify-c5b-performance.mjs",
    "verify:c5c": "node scripts/verify-c5c-release-governance.mjs",
    "verify:c5e": "node scripts/verify-c5e-human-qa.mjs",
    "verify:c5f": "node scripts/verify-c5f-evidence-package.mjs",
    "prebuild": "pnpm sync:cesium",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "cf:typegen": "wrangler types",
    "check": "tsc -b",
    "validate:scaffold": "node scripts/verify-release-scaffold.mjs"
  },
  "dependencies": {
    "cesium": "1.145.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.8.3",
    "vite": "8.2.2",
    "wrangler": "4.131.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
